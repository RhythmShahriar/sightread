{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rhythm-sightread",
          "version": "1.0.0",
          "informationUri": "https://github.com/RhythmShahriar/sightread",
          "rules": [
            {
              "id": "integrity-mismatch",
              "name": "integrity-mismatch",
              "shortDescription": {
                "text": "Archive does not match the published hash"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#integrity-mismatch",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "version-republished",
              "name": "version-republished",
              "shortDescription": {
                "text": "Same version, different bytes than the lockfile recorded"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#version-republished",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "approved-version-changed",
              "name": "approved-version-changed",
              "shortDescription": {
                "text": "Allowed version now has a different hash"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#approved-version-changed",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "known-malicious",
              "name": "known-malicious",
              "shortDescription": {
                "text": "Listed as malicious by OSV"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#known-malicious",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "wporg-closed",
              "name": "wporg-closed",
              "shortDescription": {
                "text": "Closed on WordPress.org"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#wporg-closed",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "archive-path-escape",
              "name": "archive-path-escape",
              "shortDescription": {
                "text": "Archive entry points outside the package"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#archive-path-escape",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "remote-fetch-exec",
              "name": "remote-fetch-exec",
              "shortDescription": {
                "text": "Fetches remote code and runs it"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#remote-fetch-exec",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "decode-exec",
              "name": "decode-exec",
              "shortDescription": {
                "text": "Decodes hidden code and runs it"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#decode-exec",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "admin-user-hidden",
              "name": "admin-user-hidden",
              "shortDescription": {
                "text": "Hides users from the admin user list"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#admin-user-hidden",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "lockfile-source-change",
              "name": "lockfile-source-change",
              "shortDescription": {
                "text": "Lockfile entry moved off the registry"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#lockfile-source-change",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "archive-link",
              "name": "archive-link",
              "shortDescription": {
                "text": "Archive holds a link or special file"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#archive-link",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "archive-collision",
              "name": "archive-collision",
              "shortDescription": {
                "text": "Archive holds two entries with the same name"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#archive-collision",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "unanalysed",
              "name": "unanalysed",
              "shortDescription": {
                "text": "Code that could not be analysed"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#unanalysed",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "eval-dynamic",
              "name": "eval-dynamic",
              "shortDescription": {
                "text": "Runs code built at run time"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#eval-dynamic",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "obfuscation",
              "name": "obfuscation",
              "shortDescription": {
                "text": "Adds a large encoded or scrambled blob"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#obfuscation",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "input-unserialize",
              "name": "input-unserialize",
              "shortDescription": {
                "text": "Unserializes request or remote data"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#input-unserialize",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "write-outside-package",
