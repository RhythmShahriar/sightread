              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "admin-user-create",
              "name": "admin-user-create",
              "shortDescription": {
                "text": "Creates an administrator account"
              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#admin-user-create",
              "defaultConfiguration": {
                "level": "error"
