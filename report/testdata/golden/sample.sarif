              },
              "helpUri": "https://github.com/RhythmShahriar/rhythm/wiki/Sightread-Signal-Reference#npm-install-script-new",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
